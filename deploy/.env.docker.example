# Copy to .env.docker; that file is ignored. Use a random hex database password.
POSTGRES_PASSWORD=
# When restoring existing data, preserve the source JWT_SECRET because it also
# derives the encryption key for saved Zotero integration tokens.
JWT_SECRET=

BACKEND_IMAGE=tlu-scholar-backend:local
FRONTEND_IMAGE=tlu-scholar-frontend:local
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=8080
WEB_ORIGIN=http://127.0.0.1:8080
PROJECT_REALTIME_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=1d
