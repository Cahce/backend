// colors.typ — Bảng màu dùng chung cho toàn quyển.
//
// Thân quyển ĐATN là đen trắng học thuật; riêng TRANG NHIỆM VỤ giữ nguyên màu
// của biểu mẫu Word gốc: thân xanh 0000FF, tài liệu navy 002060, tiêu đề đỏ
// FF0000, ô logo nền xám.

#let ink = rgb("#000000")
#let muted = rgb("#808080")
#let hairline = rgb("#999999")

// Màu của biểu mẫu "NHIỆM VỤ ĐỒ ÁN TỐT NGHIỆP" (đúng mã màu trong docx).
#let doc-blue = rgb("#0000FF")
#let doc-navy = rgb("#002060")
#let doc-red = rgb("#FF0000")
#let header-gray = rgb("#DBDBDB")

// Nền xám nhạt cho khối mã nguồn (nếu dùng).
#let code-bg = rgb("#f7f7f7")
